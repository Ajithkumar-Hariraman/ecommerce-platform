{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --enable-source-maps dist/server.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:test": "tsx src/database/migrate.ts --test",
    "test:integration": "npm run build && npm run db:migrate:test && node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "kafka:topics": "tsx src/events/setup-topics.ts",
    "worker:orders": "node --enable-source-maps dist/workers/order-event.worker.js",
    "worker:outbox": "node --enable-source-maps dist/workers/outbox-relay.worker.js",
    "worker:outbox:dev": "tsx src/workers/outbox-relay.worker.ts",
    "worker:orders:dev": "tsx src/workers/order-event.worker.ts",
    "postinstall": "node scripts/patch-kafkajs-timer.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sns": "^3.1164.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@google-cloud/pubsub": "^6.1.0",
    "@google-cloud/storage": "^8.2.0",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
