# Copy to .env locally. Config uses Node's built-in loader; shell values win.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_TEST_NAME=ecommerce_test
DB_USER=ecommerce_app
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# PostgreSQL remains required for Products in both modes.
ORDER_STORAGE=postgres
# Required only when ORDER_STORAGE=mongodb.
MONGODB_URI=mongodb://username:password@127.0.0.1:27018/?authSource=admin
MONGODB_DB_NAME=ecommerce_dev

PAYMENT_PROVIDER_BASE_URL=http://127.0.0.1:4100
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_LOCAL_SHARED_SECRET

AUTH_ENABLED=true
OIDC_ISSUER=http://127.0.0.1:8180/realms/ecommerce
OIDC_AUDIENCE=ecommerce-api

# Optional acceleration/coordination dependency; local dedicated Redis (not legacy 6379).
REDIS_URL=redis://127.0.0.1:6381
PRODUCT_CACHE_TTL_SECONDS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

KAFKA_BROKERS=127.0.0.1:9093
KAFKA_CLIENT_ID=ecommerce-api
KAFKA_ORDER_TOPIC=order-events
KAFKA_ORDER_RETRY_TOPIC=order-events-retry
KAFKA_ORDER_DLQ_TOPIC=order-events-dlq
KAFKA_ORDER_CONSUMER_GROUP=order-notification-worker
KAFKA_MAX_RETRIES=3

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=10

# Defaults true outside production; false in production.
DOCS_ENABLED=true

# Explicit local Compose DNS HTTP issuer opt-in; forbidden in production.
OIDC_ALLOW_HTTP=false

# Select local simulator or Razorpay Test Mode. No live-mode keys accepted in this slice.
PAYMENT_PROVIDER=local
RAZORPAY_KEY_ID=REPLACE_WITH_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_PRIVATE_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_PRIVATE_32_CHARACTER_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR
RAZORPAY_TIMEOUT_MS=8000

# Authoritative business storage: postgres or mongodb. Defaults to postgres when neither selector is set.
# BUSINESS_STORAGE takes precedence over deprecated ORDER_STORAGE.
BUSINESS_STORAGE=postgres

# Kafka remains the local default; Google SDK uses ADC / runtime service account.
EVENT_TRANSPORT=kafka
GOOGLE_CLOUD_PROJECT=ecommerce-platform-510208
GOOGLE_CLOUD_REGION=asia-south1
PUBSUB_ORDER_TOPIC=ecommerce-order-events
PUBSUB_ORDER_SUBSCRIPTION=ecommerce-order-notification-worker

# Empty bucket keeps image endpoints unavailable without affecting CRUD.
PRODUCT_ASSET_BUCKET=
PRODUCT_ASSET_SIGNER_SERVICE_ACCOUNT=
PRODUCT_ASSET_URL_TTL_SECONDS=300

# SMTP via local Mailpit; production uses private credentials and TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Commerce <orders@commerce.local>
MERCHANT_NAME=Commerce
ORDER_DOCUMENT_BUCKET=

# Increase for a scale-to-zero HTTPS identity provider cold start.
OIDC_DISCOVERY_TIMEOUT_MS=5000

# Local Mailpit remains enabled; disable only when cloud SMTP is not provisioned.
SMTP_ENABLED=true
SMTP_SECURE=false

# AWS deployment (existing local providers remain selectable until AWS E2E passes).
# CLOUD_PROVIDER=aws
# AWS_REGION=ap-south-1
# DB_TLS=true
# DB_TLS_CA_FILE=/app/certs/rds-ap-south-1-bundle.pem
# EVENT_TRANSPORT=sns-sqs
# SNS_ORDER_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT:ecommerce-dev-order-events
# SQS_ORDER_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/ecommerce-dev-order-notifications
